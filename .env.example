# ==========================================
# Remnawave API settings
# ==========================================
# Your panel URL (with https:// and no trailing slash).
PANEL_URL=https://panel.your-domain.com

# API token (created in the panel: Settings -> API Tokens; needs Subscription Settings Read/Write)
API_TOKEN=rw_YOUR_TOKEN_HERE

# Panel major version: auto | 2 | 3
# The updater only writes into Response Rules, and that API is identical on 2.x and 3.x,
# so "auto" is right for everyone. Pin it only if you want an unambiguous startup log.
PANEL_VERSION=auto

# ==========================================
# Client support toggles
# ==========================================
# Both clients are handled the same way: the routing link is written into the headers of
# the matching Response Rule and NOWHERE else. Subscription settings, custom response
# headers and any other header inside the rule are never touched.
#
# Both are ON by default. Supporting a client you have no users on costs one response
# rule and zero requests; supporting it wrongly costs a support ticket.
ENABLE_HAPP=true
ENABLE_INCY=true

# ---- Advanced: you almost certainly do not need to change anything below ----

# Substring used to find each client's rule (case-insensitive, matched against the rule
# name). Change only if your rules are named something unusual.
# HAPP_RULE_MATCH=happ
# INCY_RULE_MATCH=incy

# Create a rule when no matching one exists. It is inserted directly ABOVE the panel's
# catch-all rule (rules match top-down, so appending after it would never fire) and
# inherits that rule's responseType, so your clients keep getting the same format.
# Set to false to get a warning instead and add the rule yourself.
# CREATE_MISSING_RULES=true

# responseType for AUTO-CREATED rules only; existing rules always keep their own.
# Empty = inherit from the catch-all rule (recommended — nothing changes but the header).
# Valid: XRAY_JSON, XRAY_BASE64, MIHOMO, STASH, CLASH, SINGBOX
# HAPP_RESPONSE_TYPE=
# INCY_RESPONSE_TYPE=

# ---- Panel 2.x only ----
# 2.x still has the dedicated `happRouting` field, and its value is sent to Happ clients
# as a second `routing` header this updater no longer refreshes. Set to true to null it
# out once, so the rule header is the single source of truth. No-op on 3.x.
CLEAR_LEGACY_HAPP_ROUTING=false

# ==========================================
# Routing generation
# ==========================================
# URL your web server serves routing.json from (INCY autorouting only — Happ ignores it).
# MUST exactly match the public URL from the reverse proxy setup (see README).
# On the first cycle the service fetches this URL and tells you in the log whether the
# proxy really serves the file it just wrote — check that line before debugging anything.
# Leave it as-is / unset to run INCY on the `routing` header alone; nothing breaks.
AUTOROUTING_URL=https://sub.your-domain.com/routing.json

# Update interval in seconds. 21600 = 6 hours
UPDATE_INTERVAL_SECONDS=21600

# HTTP request timeout in seconds
REQUEST_TIMEOUT_SECONDS=30

# Retries on a network error
RETRY_ATTEMPTS=3

# ==========================================
# Geo database mirror (for regions where GitHub is blocked)
# ==========================================
# Download geoip.dat / geosite.dat to this server and serve them from your domain.
GEO_MIRROR_ENABLED=false

# Public URLs handed to clients. Point them at your reverse proxy, next to routing.json.
# Leave empty to keep the template default (GitHub) — needed only when the mirror is on.
GEOIP_URL=https://sub.your-domain.com/geoip.dat
GEOSITE_URL=https://sub.your-domain.com/geosite.dat

# Where the server pulls the databases from (default: Loyalsoldier releases on GitHub).
# Change to a mirror only if GitHub is unreachable from the server itself.
# GEOIP_SOURCE_URL=https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geoip.dat
# GEOSITE_SOURCE_URL=https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geosite.dat

# Trim the served databases to only the categories your template uses (server-side
# equivalent of the client's UseChunkFiles). Clients then download a tiny file instead
# of the full ~10-17 MB — a big win over throttled/DPI'd links. Needs GEO_MIRROR_ENABLED.
GEO_TRIM_ENABLED=false

# ==========================================
# LastUpdated stamping
# ==========================================
# interval      — bump the stamp every cycle (default, previous behaviour).
# on_geo_change — bump only when the mirrored database actually changed. Recommended
#                 together with GEO_MIRROR_ENABLED: the panel is patched only on a real
#                 update, so you can safely lower UPDATE_INTERVAL_SECONDS.
STAMP_MODE=interval
